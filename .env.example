# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is gitignored.

ANTHROPIC_API_KEY=sk-ant-replace-me
OPENAI_API_KEY=sk-replace-me

# ─── OpenRouter ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Quality judgments for non-deterministic prompts are performed by the three
# blind Copilot judge agents. JUDGE_MODEL is intentionally not used.

# Comma-separated list of models to benchmark — or a single named preset (see
# `make models` / `python -m src.main models` for the full list + descriptions).
# ── Free models (verified live against /api/v1/models on 2026-08-21) ──
TARGET_MODELS=google/gemma-4-31b-it:free,cohere/north-mini-code:free,nvidia/nemotron-3-super-120b-a12b:free
# ── Or pick a coherent preset by name instead of listing models by hand ──
# TARGET_MODELS=free_general      # same free trio as above
# TARGET_MODELS=paid_flagship     # Anthropic + Meta + OpenAI (verified live 2026-08-25)
# TARGET_MODELS=mixed_value       # 2 free models + 1 budget-paid model
# ── Paid models (production benchmark, verified live against /api/v1/models on 2026-08-25) ──
# TARGET_MODELS=anthropic/claude-sonnet-5,meta-llama/llama-3.3-70b-instruct,openai/gpt-4o-mini

# ─── Concurrency ───────────────────────────────────────────────────────────────
# Lower value recommended for free-tier models (stricter rate limits)
MAX_CONCURRENT_REQUESTS=3

# ─── Observability ───────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlruns.db

# ─── Security ────────────────────────────────────────────────────────────────────
# Named probe set for this run: "basic" (5 built-in probes, default), "owasp"
# (30 probes / OWASP GenAI LLM Top 10 2026 — needed for the dashboard's
# RSI/heatmap), or "extended" (15 advanced jailbreak/obfuscation probes).
# Can also be set per-run without touching .env: `make collect SECURITY=owasp`.
SECURITY_MODE=basic

# Optional: path to a JSON file with custom security probes — overrides
# SECURITY_MODE above when set.
SECURITY_PROBES_PATH=

# ─── Quality screen ──────────────────────────────────────────────────────────
# Number of times to send each generic quality prompt. Keep 1 for broad
# OpenRouter screening; use 2–5 only to measure stability for a short list.
QUALITY_REPETITIONS=1

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
PORT=8000

# ─── Database (uncomment and configure as needed) ─────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379/0

# ─── External Services ────────────────────────────────────────────────────────
# Add project-specific API keys and tokens here
# SERVICE_API_KEY=replace-me
